# GZCTF (real mode only; the backend is the only GZCTF client)
GZCTF_BASE_URL=https://ctf.example.com
GZCTF_GAME_ID=1
GZCTF_USERNAME=admin
GZCTF_PASSWORD=change-me

ADMIN_PASSWORD=change-me
PORT=3000

# Mock mode: simulated teams/solves (npm run dev:mock sets this for you)
MOCK_GZCTF=0
# Minutes since game start (negative = game starts in the future)
MOCK_START_OFFSET_MIN=30
MOCK_DURATION_MIN=600
# Average seconds between simulated solves
MOCK_SOLVE_INTERVAL_SEC=8
